% ================= Логотип =================
% Сейчас — векторизован из присланной картинки «профиматика» (временно, края мягкие).
% Когда дизайнеры пришлют оригиналы — положить в стиль/бренд/:
%   logo-slovo.pdf  — словесный знак «профиматика»;
%   logo-fi.pdf     — отдельная буква φ.
% Файлы подхватятся сами, ничего больше менять не нужно.
\input{стиль/бренд/логотип-контур.tex}
\newcommand\pf@risuj[5]{% #1 путь, #2 цвет, #3 высота, #4 высота в ед. пути, #5 сдвиг
  \begingroup\pgfmathsetlengthmacro\pf@u{(#3)/#4}%
  \edef\pf@do{\noexpand\tikz[baseline=0pt, x=\pf@u, y=\pf@u]
    \noexpand\fill[#2, even odd rule, shift={#5}] #1;}\pf@do\endgroup}
% \pfLogo[цвет]{высота} — буква φ
\newcommand\pfLogo[2][pfBrend]{%
  \IfFileExists{стиль/бренд/фи.pdf}{\includegraphics[height=#2]{стиль/бренд/фи.pdf}}%
    {\pf@risuj{\pfLogoFiPath}{#1}{#2}{39}{(-187,-12)}}}
% \pfLogoSlovo[цвет букв][цвет φ]{высота} — «профиматика»
\NewDocumentCommand\pfLogoSlovo{O{black} O{pfBrend} m}{%
  \IfFileExists{стиль/бренд/логотип.pdf}{\includegraphics[height=#3]{стиль/бренд/логотип.pdf}}%
    {\begingroup\pgfmathsetlengthmacro\pf@u{(#3)/40}\pgfmathsetlengthmacro\pf@b{14*\pf@u}%
     \edef\pf@do{\noexpand\tikz[x=\pf@u, y=\pf@u, baseline=\pf@b]{
       \noexpand\fill[#1, even odd rule, shift={(-96,-11)}] \pfLogoSlovoPath;
       \noexpand\fill[#2, even odd rule, shift={(-96,-11)}] \pfLogoFiPath;}}\pf@do\endgroup}}

% ================= Иконки соцсетей =================
\input{стиль/бренд/иконки.tex}
\newcommand\pfIkonka[3][pfBrend]{% [цвет]{имя: telegram|vk|youtube|max}{размер}
  \begingroup\pgfmathsetmacro\pf@s{(#3)/24}%
  \edef\pf@do{\noexpand\tikz[baseline={(0,-\the\dimexpr#3*4/5\relax)}, yscale=-1]
    \noexpand\fill[#1, scale=\pf@s] svg {\csname pfIkonka@#2\endcsname};}%
  \pf@do\endgroup}
% Ряд кликабельных иконок: \pfSocseti[цвет]{размер}
\newcommand\pfSocseti[2][pfBrend]{%
  \href{\pfTelegram}{\pfIkonka[#1]{telegram}{#2}}\hspace{0.45em}%
  \href{\pfYouTube}{\pfIkonka[#1]{youtube}{#2}}\hspace{0.45em}%
  \href{\pfVK}{\pfIkonka[#1]{vk}{#2}}}
