% Рисунок: \risunok[доля ширины]{П3.4_1}. Пока файла нет — рамка-заглушка.
\newcommand\risunok[2][0.6]{\par\smallskip\begingroup\centering
  \IfFileExists{рисунки/готовые/#2.pdf}%
    {\includegraphics[width=#1\linewidth]{рисунки/готовые/#2.pdf}}%
    {\tcbox[enhanced, colback=white, colframe=white, boxrule=0pt, arc=1mm,
      borderline={0.6pt}{0pt}{pfRamka, dashed}]{\begin{minipage}{#1\linewidth}\centering
      \vspace{6mm}\footnotesize\color{pfSeryj}рисунок #2 — в работе\vspace{6mm}\end{minipage}}}%
  \par\endgroup\smallskip}

% Заглушка темы или разбора, которые ещё не написаны
\newcommand\pfZagotovka{{\small\color{pfSeryj}\itshape Тема в работе.%
  \ifdefined\pf@cur\ifcsvoid{pf@old@\pf@cur}{}{ Источник: \csuse{pf@old@\pf@cur}.}\fi}\par}

% ================= Глава =================
\newcommand\pfGlavaKod{}\newcommand\pfRazdel{}
\newcommand\pfGlava[1]{\clearpage
  \edef\pf@g{\csuse{pf@gl@tl@#1}}%
  \renewcommand\pfKolontitul{#1 · \csuse{pf@gl@name@#1}}%
  \renewcommand\pfGlavaKod{#1}\edef\pfRazdel{\csuse{pf@gl@sec@#1}}%
  \phantomsection\label{glava:\pf@g}\hypertarget{glava:\pf@g}{}%
  \pdfbookmark[1]{#1. \csuse{pf@gl@name@#1}}{bm-glava-\pf@g}%
  \pfGlavaNastrojka
  % Плашку главы не выводим сразу: первая тема решит, какой она будет.
  % Если первая тема влезает под полную плашку — полная; если нет — компактная
  % полоска, чтобы плашка не осталась одна на пустой странице.
  \edef\pf@plArgs{{#1}{\csuse{pf@gl@name@#1}}{\csuse{pf@gl@sec@#1}}}%
  \global\pf@plashkaZhdettrue}
\newif\ifpf@plashkaZhdet
\newbox\pf@plbox
\newcommand\pfGlavaNastrojka{}
\newcommand\pf@vyvestiPlashku{\ifpf@plashkaZhdet\global\pf@plashkaZhdetfalse
  \expandafter\pfGlavaVid\pf@plArgs\fi}
% Плашка не должна потеряться, если после главы нет тем
\AddToHook{cmd/clearpage/before}{\pf@vyvestiPlashku}
\AtEndDocument{\pf@vyvestiPlashku}
% Вызывается в начале темы: полная или компактная плашка (#1 — высота темы)
\newcommand\pf@plashkaPeredTemoj[1]{\ifpf@plashkaZhdet\global\pf@plashkaZhdetfalse
  \setbox\pf@plbox=\vbox{\hsize=\linewidth\expandafter\pfGlavaVid\pf@plArgs}%
  \ifdim\dimexpr\ht\pf@plbox+\dp\pf@plbox+#1\relax>\textheight
    \ifdim#1>\textheight\expandafter\pfGlavaVid\pf@plArgs
    \else\typeout{PF-KOMPAKTNAYA-PLASHKA: \pfGlavaKod}\expandafter\pfGlavaVidMal\pf@plArgs\fi
  \else\expandafter\pfGlavaVid\pf@plArgs\fi\fi}
% Как выглядит начало главы (переопределяется в стиль/оформление/*.tex)
\newcommand\pfGlavaVid[3]{%
  {\color{pfSeryj}\small #3}\par\vspace{1mm}
  {\pfChip{\Large #1}\enspace{\Large\bfseries #2}}\par\vspace{5mm}}
\newcommand\pfGlavaVidMal[3]{{\pfChip{#1}\enspace{\bfseries #2}}\par\vspace{3mm}}

% ================= Тема =================
% Тема — одна плашка. Если плашка влезает на страницу — она не разрывается
% (не влезает в остаток страницы → целиком переезжает на следующую).
% Если тема длиннее страницы — она начинается на текущей странице (если там свободно
% больше половины) или с новой и продолжается
% на следующей с пометкой «продолжение»; сборка выводит такие темы списком.
% Внешний вид — стили pfTema, pfTemaDlin, pfRazbor в стиль/оформление.tex.
\newif\ifpf@izm
\newbox\pf@izmbox
\newcommand\pf@temaVerh{\ifpf@izm\else
  \pf@mark{tema}{\pf@x}\pdfbookmark[2]{\pf@cur\space\csuse{pf@title@\pf@cur}}{bm-tema-\pf@x}\fi}
\newcommand\pf@temaNiz{%
  \ifboolexpr{test {\ifcsvoid{pf@deps@\pf@cur}} and test {\ifcsvoid{pf@gde@\pf@cur}}
    and test {\ifcsvoid{pf@tasks@\pf@cur}}}{}{\tcblower
  \ifcsvoid{pf@deps@\pf@cur}{}{\pfMetaOpiraetsya\ \csuse{pf@deps@\pf@cur}\par}%
  \ifcsvoid{pf@gde@\pf@cur}{}{\pf@gdePervyjtrue\pfMetaGde\ \csuse{pf@gde@\pf@cur}\par}%
  \ifcsvoid{pf@tasks@\pf@cur}{}{\pfMetaZadaniya\ \pfZadaniyaSsylki{\csuse{pf@tasks@\pf@cur}}}}}
\newcommand\pfMetaOpiraetsya{Опирается на:}
\newcommand\pfMetaGde{Где встречается:}
% «Где встречается»: типы заданий через « · », каждый — ссылка на раздел типа в практике
\newif\ifpf@gdePervyj
\newcommand\pfGdeTip[1]{%
  \ifpf@gdePervyj\pf@gdePervyjfalse\else\ \textperiodcentered\ \fi
  \edef\pf@y{\csuse{pf@tl@#1}}%
  \def\pf@txt{№\,\csuse{pf@task@#1}~— \csuse{pf@title@#1}}%
  \ifcsdef{pf@have@tip:\pf@y}%
    {\hyperlink{tip:\pf@y}{\textcolor{pfAkcent}{\pf@txt}}\pfStr{\getpagerefnumber{tip:\pf@y}}}%
    {\ifcsdef{r@EXT-tip:\pf@y}%
      {\pf@txt\,{\footnotesize практика, с.\,\getpagerefnumber{EXT-tip:\pf@y}}}%
      {\pf@txt}}}
\newcommand\pfMetaZadaniya{Задания ЕГЭ: №}
% Номера заданий в теме — ссылки на раздел «Задания ЕГЭ → темы» (если он есть в книге)
\ExplSyntaxOn
\NewDocumentCommand\pfZadaniyaSsylki{m}{
  \clist_set:Ne \l_tmpa_clist {#1}
  \cs_if_exist:cTF {r@ukazatel}
    { \clist_clear:N \l_tmpb_clist
      \clist_map_function:NN \l_tmpa_clist \pf_zad_ssylka:n
      \clist_use:Nn \l_tmpb_clist {,~} }
    { \clist_use:Nn \l_tmpa_clist {,~} } }
\cs_new_protected:Npn \pf_zad_ssylka:n #1
  { \clist_put_right:Nn \l_tmpb_clist { \pfZadanieSsylka{#1} } }
\ExplSyntaxOff
\newcommand\pfZadanieSsylka[1]{\hyperlink{ukaz:#1}{\textcolor{pfAkcent}{#1}}}
\newcommand\pfDlinnyeTemy{}

\NewDocumentEnvironment{tema}{m +b}{%
  \def\pf@cur{#1}\edef\pf@x{\csuse{pf@tl@#1}}%
  \pf@izmtrue
  \setbox\pf@izmbox=\vbox{\hsize=\linewidth
    \begin{tcolorbox}[pfTema={#1}, before skip=0pt, after skip=0pt]#2\pf@temaNiz\end{tcolorbox}}%
  \pf@izmfalse
  \pf@plashkaPeredTemoj{\dimexpr\ht\pf@izmbox+\dp\pf@izmbox\relax}%
  \ifdim\dimexpr\ht\pf@izmbox+\dp\pf@izmbox\relax>\textheight
    \typeout{PF-DLINNAYA: #1}%
    \par\ifdim\dimexpr\pagegoal-\pagetotal\relax<0.5\textheight\clearpage\fi
    \begin{tcolorbox}[pfTema={#1}, pfTemaDlin={#1}]\pf@temaVerh#2\pf@temaNiz\end{tcolorbox}%
  \else
    \begin{tcolorbox}[pfTema={#1}]\pf@temaVerh#2\pf@temaNiz\end{tcolorbox}%
  \fi}{}

% ================= Практика: задание и разбор =================
\newcommand\pfZadanie[1]{\clearpage
  \renewcommand\pfKolontitul{Задание #1}%
  \renewcommand\pfGlavaKod{№\,#1}\renewcommand\pfRazdel{Практика}%
  \phantomsection\label{zadanie:#1}\hypertarget{zadanie:#1}{}%
  \pdfbookmark[1]{Задание #1}{bm-zadanie-#1}%
  \pfZadanieVid{#1}}
\newcommand\pfZadanieVid[1]{%
  {\pfChip{\Large №\,#1}\enspace{\Large\bfseries Задание #1}}\par\vspace{5mm}}
% Тип внутри задания: \pfTip{11.1} — заголовок раздела + ссылка на задачи этого типа в банке
\newcommand\pfTip[1]{\par
  \edef\pf@y{\csuse{pf@tl@#1}}%
  \pdfbookmark[2]{#1 \csuse{pf@title@#1}}{bm-tip-\pf@y}%
  \pfTipVid{#1}}
\newcommand\pfTipVid[1]{\par\medskip\pf@mark{tip}{\pf@y}{\large\bfseries #1 \csuse{pf@title@#1}}\par\smallskip}

\NewDocumentEnvironment{razbor}{m}{%
  \def\pf@cur{#1}\edef\pf@x{\csuse{pf@tl@#1}}%
  \begin{tcolorbox}[pfRazbor={#1}]%
  \pf@mark{razbor}{\pf@x}\pdfbookmark[2]{#1 \csuse{pf@title@#1}}{bm-razbor-\pf@x}%
  \ifcsvoid{pf@need@#1}{}{{\footnotesize\color{pfSeryj}Понадобится: \csuse{pf@need@#1}%
    \ifcsvoid{pf@needaux@#1}{}{; ещё пригодится: \csuse{pf@needaux@#1}}}\par\smallskip}}%
  {\end{tcolorbox}}
\newcommand\Uslovie{{\color{pfPurple}\pfMedium Условие. }}
\newcommand\Reshenie{\par\smallskip{\color{pfPurple}\pfMedium Решение. }}
\newcommand\Otvet[1]{\par\smallskip{\color{pfPurple}\pfMedium Ответ: }#1\par}

% ================= Оглавления и указатель =================
\newcommand\pf@toc[3]{% ссылка, текст, метка страницы
  \par\noindent\hyperlink{#1}{#2}\dotfill\hyperlink{#1}{\pageref*{#3}}\par\vspace{1.2mm}}
\newcommand\pfStrokaGlavy[1]{\edef\pf@g{\csuse{pf@gl@tl@#1}}%
  \pf@toc{glava:\pf@g}{\pfKod{#1}\enspace\csuse{pf@gl@name@#1}}{glava:\pf@g}}
\newcommand\pfStrokaZadaniya[1]{\pf@toc{zadanie:#1}{\pfKod{№\,#1}\enspace Задание #1}{zadanie:#1}}
% Указатель «задание → темы» (в конце книги). Внешний вид — в стиль/оформление.tex.
% \pfUkNavigaciya{1,2,…} — список заданий; \pfUkazatel{n}{\pfUkGlava{глава}{\pfUkTema{код}{номер}…}…}
\RequirePackage{needspace}
\newcommand\pfUkNavigaciya[1]{\forcsvlist{\pfUkStrokaNav}{#1}}
\newcommand\pfUkStrokaNav[1]{\par\noindent\hyperlink{ukaz:#1}{№\,#1 \csuse{pf@zadname@#1}}}
\newcommand\pfUkazatel[2]{\par\Needspace{30mm}\phantomsection\hypertarget{ukaz:#1}{}%
  \noindent{\pfMedium №\,#1 \csuse{pf@zadname@#1}}\par#2\par\vspace{3mm}}
\newcommand\pfUkGlava[2]{\par\Needspace{12mm}\noindent #1 \csuse{pf@gl@name@#1}\par#2}
\newcommand\pfUkTema[2]{\edef\pf@x{\csuse{pf@tl@#1}}\par\noindent\hspace*{1em}%
  \ifcsdef{pf@have@tema:\pf@x}{\hyperlink{tema:\pf@x}{#1 \csuse{pf@title@#1}}}{#1 \csuse{pf@title@#1}}\par}
% Есть ли в книге указатель (для ссылки «Задания» внизу страницы)
\newcommand\pfEsliUkazatel[1]{\ifcsdef{r@ukazatel}{#1}{}}

\newcommand\pfTitul[2]{% заголовок книги, подзаголовок
  \thispagestyle{empty}\vspace*{30mm}
  {\color{pfSeryj}\large Профиматика · ЕГЭ по профильной математике}\par\vspace{4mm}
  {\fontsize{30}{34}\selectfont\bfseries #1}\par\vspace{3mm}
  {\large #2}\par\vfill
  {\footnotesize\color{pfSeryj}Пилотная версия. Сборка от \today}\clearpage}

\newcommand\pfOglavlenie[2]{% заголовок, файл со строками
  \phantomsection\hypertarget{oglavlenie}{}%
  \pdfbookmark[0]{#1}{bm-#1}%
  {\Large\bfseries #1}\par\vspace{5mm}\input{#2}\clearpage}

