% ================= Варианты сборки =================
% \pfKniga{теория} | \pfKniga{практика} | \pfKniga{одна}
\newcommand\pfNazvanieKnigi{Шпора ЕГЭ · профиль}
\newcommand\pfKniga[1]{\def\pf@kniga{#1}%
  \ifstrequal{#1}{теория}{\externaldocument[EXT-]{практика}}{}%
  \ifstrequal{#1}{практика}{\externaldocument[EXT-]{теория}}{}}
\def\pf@kniga{одна}

% Собрать только часть глав (для пилота): \pfTolkoGlavy{Ч1,А1}
\def\pf@tolko{}
