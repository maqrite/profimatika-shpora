% ================= Данные из таблицы (заполняет generate.py) =================
\newcommand\pfDefGlava[4]{% код, латиница, название, раздел
  \csdef{pf@gl@tl@#1}{#2}\csdef{pf@gl@name@#1}{#3}\csdef{pf@gl@sec@#1}{#4}}
\newcommand\pfDefTema[8]{% код, латиница, название, глава, опирается, задания, старое, где встречается
  \csdef{pf@tl@#1}{#2}\csdef{pf@title@#1}{#3}\csdef{pf@ch@#1}{#4}%
  \csdef{pf@deps@#1}{#5}\csdef{pf@tasks@#1}{#6}\csdef{pf@old@#1}{#7}\csdef{pf@gde@#1}{#8}}
\newcommand\pfGlavaTemy[2]{\csdef{pf@gl@temy@#1}{#2}}       % список тем главы
\newcommand\pfDefZadanie[3]{% номер, название, все типы задания (из банка задач)
  \csdef{pf@zadname@#1}{#2}\csdef{pf@zadtipy@#1}{#3}}
\newcommand\pfDefTip[6]{% код (11.1), латиница, задание, название, задач в банке, ссылка в банке
  \csdef{pf@tl@#1}{#2}\csdef{pf@task@#1}{#3}\csdef{pf@title@#1}{#4}%
  \csdef{pf@bankn@#1}{#5}\csdef{pf@bankurl@#1}{#6}}
\newcommand\pfZadanieTipy[2]{\csdef{pf@zad@tipy@#1}{#2}}     % типы, по которым в шпоре есть разборы
\newcommand\pfDefRazbor[7]{% код, латиница, задание, заголовок, ключевые темы, вспомогательные, тип
  \csdef{pf@tl@#1}{#2}\csdef{pf@task@#1}{#3}\csdef{pf@title@#1}{#4}%
  \csdef{pf@need@#1}{#5}\csdef{pf@needaux@#1}{#6}\csdef{pf@tip@#1}{#7}}

% ================= Ссылки по кодам =================
% \tref{П3.1} — на тему, \rref{Р16-01} — на разбор, \trefk — компактно, без страницы.
% В этой же книге: кликабельно + страница. В другой книге: «теория, с. 12». Нет нигде: просто код.
\newcommand\pfKod[1]{\textcolor{pfAkcent}{\pfMedium #1}}
\newcommand\pfStr[1]{\,{\color{pfSeryj}\footnotesize с.\,#1}}
\newcommand\pf@ref[4]{% #1 код, #2 вид (tema/razbor), #3 подпись другой книги, #4 со страницей?
  \edef\pf@x{\ifcsdef{pf@tl@#1}{\csuse{pf@tl@#1}}{}}%
  \ifdefempty{\pf@x}{\pfKod{#1}\PackageWarning{shpora}{Неизвестный код #1}}{%
    \ifcsdef{pf@have@#2:\pf@x}%
      {\hyperlink{#2:\pf@x}{\pfKod{#1}}\ifstrequal{#4}{y}{\pfStr{\getpagerefnumber{#2:\pf@x}}}{}}%
      {\ifcsdef{r@EXT-#2:\pf@x}%
        {\pfKod{#1}\ifstrequal{#4}{y}{\,{\color{pfSeryj}\footnotesize #3, с.\,\getpagerefnumber{EXT-#2:\pf@x}}}{}}%
        {\pfKod{#1}}}}}
\newcommand\tref[1]{\pf@ref{#1}{tema}{теория}{y}}
\newcommand\trefk[1]{\pf@ref{#1}{tema}{теория}{n}}
\newcommand\rref[1]{\pf@ref{#1}{razbor}{практика}{y}}

\newcommand\pf@mark[2]{% отметить, что объект есть в этой книге (через aux)
  \immediate\write\@auxout{\string\csgdef{pf@have@#1:#2}{}}%
  \phantomsection\hypertarget{#1:#2}{}\label{#1:#2}}

% ================= Мелкие элементы =================
\newcommand\pfChip[2][pfAkcent]{\tcbox[on line, colback=#1, colupper=white, boxrule=0pt,
  arc=1mm, boxsep=0pt, left=1.3mm, right=1.3mm, top=0.7mm, bottom=0.7mm]{\pfMedium\small #2}}
\newcommand\opr[1]{\textbf{#1}}      % определяемый термин
\newcommand\nomer[1]{{\color{pfSeryj}\footnotesize(#1)}}   % номер формулы внутри темы

